# =============================================================================
# TEMPLATE NESTJS API — variáveis de ambiente (dev local)
# =============================================================================

# --- App (Nest) ---
PORT=3000
APP_PORT=3000
NODE_ENV=development

# --- Banco local ---
DB_NAME=lobocode_local
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lobocode_local?schema=public"

# --- JWT ---
JWT_SECRET=lobocode_local_dev_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO (app) ---
MINIO_HOST=lobocode-local-minio
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_USE_SSL=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=lobocode-files-dev
MINIO_CONSOLE_PORT=9001

# --- Stack database (docker-compose.database.yml + scripts/start-database.sh) ---
COMPOSE_DATABASE_PROJECT_NAME=lobocode-local-database
DOCKER_NETWORK_NAME=app-net-lobocode-local
DB_CONTAINER_NAME=lobocode-local-db
REDIS_CONTAINER_NAME=lobocode-local-redis
MINIO_CONTAINER_NAME=lobocode-local-minio
POSTGRES_VOLUME_NAME=lobocode_local_postgres_data
REDIS_VOLUME_NAME=lobocode_local_redis_data
MINIO_VOLUME_NAME=lobocode_local_minio_data
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Backend na VPS (mantido para compatibilidade de scripts) ---
COMPOSE_VPS_STACK_NAME=lobocode-template-vps
BACKEND_CONTAINER_NAME=lobocode-template-backend
VPS_APP_PROJECT_NAME=lobocode-template
APP_HOST=api.lobocode.localtest.me
APP_DISPLAY_NAME="Lobocode Template Dev"
VPS_APP_COMPOSE_FILE=docker/docker-compose.vps-app.yml
VPS_DEFAULT_SERVICE=backend
APP_HOST_EXAMPLE=api.seu-dominio.com

# Labels Traefik no app
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Observabilidade (opcional) ---
ENABLE_PROMETHEUS_METRICS=false
ENABLE_AUDIT_LOGS=false
PROMETHEUS_METRICS_PREFIX=lobocode_
METRICS_EXPORT_INTERVAL=15s
PROMETHEUS_BASE_URL=http://localhost:9090
GRAFANA_BASE_URL=http://localhost:3000

# --- E-mail / URLs (dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev@example.com
SMTP_PASS=dev_password
SMTP_FROM="Lobocode Dev <dev@example.com>"
SUPPORT_EMAIL=support@localhost
AUTH_RESET_PASSWORD_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
GEOCODING_USER_AGENT=lobocode-template-dev/1.0

# --- Integrações (opcional em dev) ---
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_CUSTOMER_ID=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_URL=http://localhost:3000/asaas/webhooks/payments
ASAAS_WEBHOOK_TOKEN=
 