# =============================================================================
# TEMPLATE NESTJS API — variáveis de ambiente (padrão backend)
# =============================================================================

# --- App (Nest) ---
PORT=3000
APP_PORT=3000
NODE_ENV=development 

# --- Banco (URL local; na VPS o compose injeta DATABASE_URL) ---
DB_NAME=lobocode_template
DB_USER=postgres
DB_PASSWORD=lobocode_template_pass
DATABASE_URL="postgresql://postgres:lobocode_template_pass@localhost:5433/lobocode_template?schema=public"

# --- JWT ---
JWT_SECRET=lobocode_template_jwt_change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO (app) ---
MINIO_HOST=lobocode-template-minio
MINIO_PORT=9000
MINIO_ROOT_USER=lobocode_minio
MINIO_ROOT_PASSWORD=lobocode_minio_pass
MINIO_USE_SSL=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=lobocode-files
MINIO_CONSOLE_PORT=9001

# --- Stack database (docker-compose.database.yml + scripts/start-database.sh) ---
COMPOSE_DATABASE_PROJECT_NAME=template-nestjs-api-database
DOCKER_NETWORK_NAME=app-net-lobocode-template
DB_CONTAINER_NAME=lobocode-template-db
REDIS_CONTAINER_NAME=lobocode-template-redis
MINIO_CONTAINER_NAME=lobocode-template-minio
POSTGRES_VOLUME_NAME=template-nestjs-api-postgres-data
REDIS_VOLUME_NAME=template-nestjs-api-redis-data
MINIO_VOLUME_NAME=template-nestjs-api-minio-data
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Backend na VPS (docker-compose.vps-app.yml) ---
COMPOSE_VPS_STACK_NAME=template-nestjs-api-vps
BACKEND_CONTAINER_NAME=lobocode-template-backend
VPS_APP_PROJECT_NAME=lobocode-template
APP_HOST=api.lobocode.localtest.me
APP_DISPLAY_NAME="Lobocode Template API"
VPS_APP_COMPOSE_FILE=docker/docker-compose.vps-app.yml
VPS_DEFAULT_SERVICE=backend
APP_HOST_EXAMPLE=api.seu-dominio.com

# Labels Traefik no app — devem coincidir com traefik/.env.gateway na VPS
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- E-mail / URLs (opcional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=template@lobocode.com
SMTP_PASS=template_smtp_pass
SMTP_FROM="Lobocode Template <template@lobocode.com>"
SUPPORT_EMAIL=support@lobocode.com
AUTH_RESET_PASSWORD_URL=https://app.lobocode.localtest.me
FRONTEND_URL=https://app.lobocode.localtest.me
GEOCODING_USER_AGENT=lobocode-template/1.0

# --- Observabilidade (opcional) ---
ENABLE_PROMETHEUS_METRICS=false
ENABLE_AUDIT_LOGS=false
PROMETHEUS_METRICS_PREFIX=lobocode_
METRICS_EXPORT_INTERVAL=15s
PROMETHEUS_BASE_URL=http://localhost:9090
GRAFANA_BASE_URL=http://localhost:3000

# --- Integrações (opcional) ---
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_CUSTOMER_ID=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_URL=https://api.lobocode.localtest.me/asaas/webhooks/payments
ASAAS_WEBHOOK_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

