// Schema principal — generator, datasource e documentação geral.
// Modelos e enums: prisma/modules/**
//
// Documentação dos relacionamentos: docs/PRISMA_RELACIONAMENTOS.md
//
// Mapa rápido (alinhado a mockData + admin/mocks):
// - Tenant: Company + CompanyUnit (filiais) + defaults operacionais
// - User: auth + overrides por profissional + plano/cuidado paciente
// - Catálogo: Specialty, Service
// - Agenda: ProfessionalBlockedTime, ScheduleReminder, Appointment, WaitingListEntry
// - Financeiro: Payment (app) + Charge (admin)
// - Admin: Integration, AuditLog
// - Documentos: Document ↔ File; MedicalRecord
// - Notificações: Notification*, PushSubscription

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
