// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Documentação dos relacionamentos e diagramas: docs/PRISMA_RELACIONAMENTOS.md
//
// Mapa rápido (alinhado a mockData + admin/mocks):
// - Tenant: Company + CompanyUnit (filiais) + defaults operacionais
// - User: auth + overrides por profissional (mock Professional) + plano/cuidado paciente (admin PatientRow)
// - Catálogo: Specialty, Service (adminCatalogEntities)
// - Agenda: ProfessionalBlockedTime, ScheduleReminder, Appointment, WaitingListEntry
// - Financeiro: Payment (app) + Charge (cobranças admin / ChargeRow)
// - Admin: Integration, AuditLog
// - Documentos: Document (único) ↔ File; tipo via `documentType` (corporativo, clínico, prontuário)
// - Notificações: Notification*, PushSubscription

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Papéis e estados base (auth / multi-tenant) ---

/// Papel do utilizador na plataforma (JWT + CASL + UI).
enum Roles {
  SYSTEM_ADMIN
  ADMIN
  PATIENT
  PROFESSIONAL
}

/// Ciclo de vida da conta (login, convites, bloqueios).
enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

// --- Armazenamento genérico (MinIO) ---

/// Tipo semântico do ficheiro no armazenamento objeto (S3/MinIO).
enum FileType {
  PROFILE_IMAGE
  DOCUMENT
  REPORT
  VIDEO
  AUDIO
  OTHER
}

// --- Documentos (único modelo; semântica via `DocumentType`) ---

/// Tipo semântico do registo `Document` (corporativo, clínico ou anexo de prontuário).
enum DocumentType {
  CORPORATE_HR
  CORPORATE_SUPERVISOR
  CORPORATE_ADMIN
  CLINICAL_EXAM
  CLINICAL_PRESCRIPTION
  CLINICAL_REPORT
  CLINICAL_OTHER
  MEDICAL_RECORD_ATTACHMENT
}

/// Estado de entrega / disponibilidade (corporativo + clínico `READY`).
enum DocumentStatus {
  PENDING
  VIEWED
  DOWNLOADED
  READY
}

// --- Notificações in-app (alinhado ao frontend: tipo + actionUrl) ---

/// Modo de formação do grupo de notificação.
enum NotificationGroupType {
  ROLE
  SECTOR
  CUSTOM
}

/// Tipo de alvo de uma notificação em campanha (utilizador, papel, grupo, etc.).
enum NotificationTargetType {
  USER
  ROLE
  GROUP
  COMPANY
  CUSTOM
}

/// Categorias usadas no app paciente/profissional (`Notification.type` no React).
enum AppNotificationCategory {
  APPOINTMENT
  PAYMENT
  DOCUMENT
  REMINDER
  WAITING_LIST
}

// --- Domínio assistencial / agenda (alinhado a `weliv-app-lobocode` types) ---

/// Modalidade da consulta (extensível no futuro, ex.: telemedicina).
enum AppointmentType {
  PRESENCIAL
}

/// Estado operacional do agendamento.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Meio de pagamento registrado na consulta.
enum PaymentMethod {
  PIX
  CREDIT
  DEBIT
  BOLETO
}

/// Estado da cobrança/pagamento.
enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// Estado operacional do paciente nas listagens admin (`PatientRow.status`).
enum PatientCareStatus {
  ACTIVE
  INACTIVE
  NEEDS_ATTENTION
}

/// Itens de catálogo (especialidade, serviço) — `adminCatalogEntities`.
enum CatalogItemStatus {
  ACTIVE
  INACTIVE
}

/// Cobrança / contas a receber (`ChargeRow` no admin; `cartão` agrega crédito/débito).
enum ChargeMethod {
  PIX
  CARD
  BOLETO
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
}

/// Saúde da integração (`IntegrationRow.status`).
enum IntegrationHealthStatus {
  HEALTHY
  UNSTABLE
  DOWN
}

/// Severidade do evento de auditoria (`AuditLogRow.status`).
enum AuditLogSeverity {
  OK
  WARNING
  CRITICAL
}

// ============================================================================
// Tenant
// ============================================================================

/// Organização (tenant). Filiais: `CompanyUnit` (`ChargeRow.unit`, `UserRow.unit` no admin).
model Company {
  id   String @id @default(cuid())
  name String

  /// Destaque público / nome fantasia.
  tagline            String?
  /// Apresentação institucional.
  description        String?  @db.Text
  cnpj               String?
  address            String?
  /// Registro operacional da sede (CNES, alvará).
  registrationNumber String?
  /// Especialidade principal divulgada pela marca.
  specialty          String?
  /// Preço base de referência (profissional pode sobrepor em `User.consultationPrice`).
  consultationPrice  Decimal? @db.Decimal(12, 2)
  acceptsInsurance   Boolean  @default(false)
  /// Lista de convênios (`string[]` JSON); profissional pode sobrepor em `User.insurances`.
  insurances         Json     @default("[]")
  /// Grade padrão `WeekSchedule` (JSON); profissional pode sobrepor em `User.availableSchedule`.
  availableSchedule  Json     @default("{}")

  remarcationEnabled Boolean @default(true)
  remarcationLimit   Int     @default(0)
  waitingListEnabled Boolean @default(false)
  /// Percentual de sinal: 0, 10, 30 ou 100.
  depositPercentage  Int     @default(0)

  units              CompanyUnit[]
  specialties        Specialty[]
  services           Service[]
  users              User[]
  documents          Document[]          @relation("CompanyDocuments")
  files              File[]              @relation("CompanyFiles")
  notifications      Notification[]      @relation("CompanyNotifications")
  notificationGroups NotificationGroup[] @relation("CompanyNotificationGroups")
  appointments       Appointment[]
  payments           Payment[]
  charges            Charge[]
  medicalRecords     MedicalRecord[]
  integrations       Integration[]
  auditLogs          AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([id])
  @@index([name])
  @@index([specialty])
  @@index([cnpj])
  @@index([createdAt])
  @@index([updatedAt])
}

/// Unidade / filial (`ChargeRow.unit`, `UserRow.unit` no admin).
model CompanyUnit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  code     String?
  address  String?
  isActive Boolean @default(true)

  users   User[]   @relation("UserPrimaryUnit")
  charges Charge[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([name])
}

/// Catálogo de especialidades (`adminCatalogSpecialties`). `companyId` null = catálogo partilhado/plataforma.
model Specialty {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name   String
  status CatalogItemStatus @default(ACTIVE)

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([status])
}

/// Catálogo de serviços (`adminCatalogServicesSeed`).
model Service {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  status      CatalogItemStatus @default(ACTIVE)
  specialtyId String?
  specialty   Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([specialtyId])
  @@index([status])
}

// ============================================================================
// Utilizador (auth); campos extra alinhados ao `User` do frontend (telefone, avatar, nascimento)
// ============================================================================

/// Conta autenticável. Campos `professional*` / agenda espelham `Professional` em `mockData` (sobrepõem `Company` quando preenchidos).
/// `healthPlan` / `patientCareStatus` alinham `PatientRow` do admin.
model User {
  id       String     @id @default(cuid())
  name     String
  login    String     @unique
  email    String     @unique
  cpf      String     @unique
  password String
  role     Roles
  status   UserStatus @default(PENDING)

  /// Telefone e avatar: `User` / `Professional` / `Patient` no frontend.
  phone     String?
  avatarUrl String?
  birthDate DateTime? @db.Date

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  /// Unidade principal de lotação (`UserRow.unit` no admin).
  primaryUnit   CompanyUnit? @relation("UserPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull)
  primaryUnitId String?

  /// --- Profissional (`mockProfessionals`) — opcional; null usa defaults da `Company`. ---
  professionalTitle   String?
  biography           String?  @db.Text
  professionalCnpj    String?
  professionalAddress String?
  /// CRM / registro no conselho (`registrationNumber` no mock).
  registrationNumber  String?
  /// Texto livre; pode alinhar depois a `Specialty` por catálogo.
  specialty           String?
  consultationPrice   Decimal? @db.Decimal(12, 2)
  acceptsInsurance    Boolean?
  insurances          Json?
  availableSchedule   Json?
  remarcationEnabled  Boolean?
  remarcationLimit    Int?
  waitingListEnabled  Boolean?
  depositPercentage   Int?

  /// --- Paciente (admin `PatientRow.plan`) ---
  healthPlan        String?
  patientCareStatus PatientCareStatus?

  /// Ultimo acesso (admin `UserRow.lastAccess`).
  lastAccessAt DateTime?

  /// Documentos corporativos (remetente) e metadados clínicos quando aplicável.
  documentsSent                 Document[]                @relation("DocumentSender")
  documentsAsPatient            Document[]                @relation("DocumentPatient")
  documentsAsProfessionalAuthor Document[]                @relation("DocumentProfessionalAuthor")
  /// Metadados de ficheiros carregados por este utilizador.
  files                         File[]                    @relation("UserFiles")
  pushSubscriptions             PushSubscription[]        @relation("UserPushSubscriptions")
  notificationGroupMembers      NotificationGroupMember[] @relation("UserGroupMemberships")
  /// Inbox: notificações recebidas (linha por campanha).
  notificationRecipients        NotificationRecipient[]   @relation("UserNotifications")

  /// Bloqueios de agenda do profissional (`role = PROFESSIONAL`); dados operacionais da clínica vivem em `Company`.
  professionalBlockedTimes ProfessionalBlockedTime[]

  patientAppointments      Appointment[] @relation("PatientAppointments")
  professionalAppointments Appointment[] @relation("ProfessionalAppointments")

  paymentsAsPatient      Payment[] @relation("PaymentPatient")
  paymentsAsProfessional Payment[] @relation("PaymentProfessional")

  medicalRecordsAsPatient      MedicalRecord[] @relation("MedicalRecordPatient")
  medicalRecordsAsProfessional MedicalRecord[] @relation("MedicalRecordProfessional")

  waitingListAsPatient      WaitingListEntry[] @relation("WaitingListPatient")
  waitingListAsProfessional WaitingListEntry[] @relation("WaitingListProfessional")

  /// Lembretes criados pelo profissional na sua agenda.
  scheduleReminders ScheduleReminder[]

  chargesAsPatient Charge[]   @relation("ChargePatient")
  auditLogsAsActor AuditLog[] @relation("AuditLogActor")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([primaryUnitId])
  @@index([id])
  @@index([email])
  @@index([patientCareStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================================
// Financeiro admin — cobranças (`ChargeRow`)
// ============================================================================

/// Conta a receber / cobrança exibida no módulo financeiro do admin.
model Charge {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyUnitId String?
  companyUnit   CompanyUnit? @relation(fields: [companyUnitId], references: [id], onDelete: SetNull)

  patientId String
  patient   User   @relation("ChargePatient", fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Referência humana tipo `APT-1040` (`appointmentRef` no mock).
  externalReference String?

  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime     @db.Date
  method         ChargeMethod
  status         ChargeStatus @default(PENDING)
  /// Ultimo lembrete enviado (lastReminderAt no mock).
  lastReminderAt DateTime?
  paidAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyUnitId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([dueDate])
  @@index([status])
}

// ============================================================================
// Admin — integrações e auditoria (`IntegrationRow`, `AuditLogRow`)
// ============================================================================

model Integration {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  type          String
  lastSyncLabel String? /// texto livre UI ("Há 3 min", "Falhou")
  lastSyncAt    DateTime?
  latencyMs     Int?
  status        IntegrationHealthStatus @default(HEALTHY)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([status])
}

model AuditLog {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  event       String
  actorName   String
  area        String
  /// Rótulo de data/hora exibido no mock; use também `occurredAt` para ordenação.
  occurredAt  DateTime @default(now())
  displayTime String?

  actorUserId String?
  actorUser   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  severity AuditLogSeverity @default(OK)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([occurredAt])
  @@index([severity])
  @@index([actorUserId])
}

// ============================================================================
// Agenda — bloqueios por profissional (utilizador com `companyId` da mesma empresa)
// ============================================================================

/// Intervalo indisponível na agenda **do profissional** (utilizador). Políticas e grade horária da clínica: `Company`.
model ProfessionalBlockedTime {
  id                 String @id @default(cuid())
  professionalUserId String
  professional       User   @relation(fields: [professionalUserId], references: [id], onDelete: Cascade)

  blockedDate DateTime @db.Date
  startTime   String
  endTime     String
  reason      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalUserId])
  @@index([blockedDate])
}

/// Lembretes da agenda do profissional (`ScheduleReminder` no frontend).
model ScheduleReminder {
  id                 String @id @default(cuid())
  professionalUserId String
  professional       User   @relation(fields: [professionalUserId], references: [id], onDelete: Cascade)

  title    String
  remindAt DateTime
  note     String?

  createdAt DateTime @default(now())

  @@index([professionalUserId])
  @@index([remindAt])
}

// ============================================================================
// Consultas e lista de espera
// ============================================================================

/// Consulta agendada entre um paciente e um profissional. Filhos: documentos clínicos e pagamentos.
model Appointment {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  patientId String
  patient   User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("ProfessionalAppointments", fields: [professionalId], references: [id], onDelete: Cascade)

  /// Instantâneo único da consulta (substitui `date` + `time` string do frontend na persistência).
  startsAt DateTime

  type AppointmentType @default(PRESENCIAL)

  status AppointmentStatus @default(SCHEDULED)

  remarcationCount Int     @default(0)
  depositPaid      Boolean @default(false)
  depositAmount    Decimal @default(0) @db.Decimal(12, 2)
  notes            String? @db.Text

  documents Document[] @relation("AppointmentDocuments")
  payments  Payment[]
  charges   Charge[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([patientId])
  @@index([professionalId])
  @@index([startsAt])
  @@index([status])
  @@index([deletedAt])
}

/// Pedido de vaga quando o horário desejado não está livre.
model WaitingListEntry {
  id String @id @default(cuid())

  patientId String
  patient   User   @relation("WaitingListPatient", fields: [patientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("WaitingListProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  desiredDate DateTime @db.Date
  desiredTime String

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([professionalId])
  @@index([desiredDate])
}

// ============================================================================
// Pagamentos (frontend `Payment`)
// ============================================================================

/// Cobrança associada a uma consulta (paciente e profissional redundantes para consultas e relatórios).
model Payment {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  patientId String
  patient   User   @relation("PaymentPatient", fields: [patientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("PaymentProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  installments Int?
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([professionalId])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================================
// Prontuário (medicalRecordService no frontend)
// ============================================================================

/// Evolução clínica por par (profissional, paciente); campos do paciente podem estar denormalizados para histórico.
model MedicalRecord {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  professionalUserId String
  professional       User   @relation("MedicalRecordProfessional", fields: [professionalUserId], references: [id], onDelete: Cascade)

  patientUserId String
  patient       User   @relation("MedicalRecordPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  /// Denormalizados para histórico / exibição (espelho do frontend).
  patientName      String
  patientCpf       String
  patientBirthDate DateTime @db.Date

  bloodType          String?
  /// string[] no frontend
  allergies          Json    @default("[]")
  chronicConditions  Json    @default("[]")
  /// { name, dosage, since }[]
  currentMedications Json    @default("[]")

  lastConsultAt   DateTime
  chiefComplaint  String   @db.Text
  clinicalSummary String   @db.Text

  documents Document[] @relation("MedicalRecordDocuments")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([professionalUserId])
  @@index([patientUserId])
  @@index([lastConsultAt])
  @@index([deletedAt])
}

// ============================================================================
// Ficheiros (MinIO)
// ============================================================================

/// Objeto binário no armazenamento; cada `File` pode ser referenciado por no máximo um `Document`.
model File {
  id           String   @id @default(cuid())
  originalName String
  fileName     String   @unique
  type         FileType
  size         Int
  mimeType     String
  url          String   @unique
  description  String?

  companyId      String?
  company        Company?  @relation("CompanyFiles", fields: [companyId], references: [id])
  uploadedBy     String?
  uploadedByUser User?     @relation("UserFiles", fields: [uploadedBy], references: [id])
  document       Document? @relation("DocumentFile")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([uploadedBy])
  @@index([type])
  @@index([fileName])
  @@index([url])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================================
// Documento único (corporativo, clínico ou anexo de prontuário) ↔ File
// ============================================================================

/// Metadados do documento; o binário está sempre em `File` (`fileId` 1:1).
model Document {
  id           String         @id @default(cuid())
  documentType DocumentType
  status       DocumentStatus @default(PENDING)
  description  String?
  /// Título ou nome exibido (clínico, anexo de prontuário, etc.).
  name         String?
  /// URL opcional (legado); preferir `file.url`.
  url          String?

  fileId String @unique
  file   File   @relation("DocumentFile", fields: [fileId], references: [id])

  /// Remetente — fluxo corporativo (RH); opcional noutros tipos.
  userId String?
  user   User?   @relation("DocumentSender", fields: [userId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation("CompanyDocuments", fields: [companyId], references: [id])

  patientId String?
  patient   User?   @relation("DocumentPatient", fields: [patientId], references: [id], onDelete: Cascade)

  professionalId String?
  professional   User?   @relation("DocumentProfessionalAuthor", fields: [professionalId], references: [id], onDelete: SetNull)

  appointmentId String?
  appointment   Appointment? @relation("AppointmentDocuments", fields: [appointmentId], references: [id], onDelete: SetNull)

  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation("MedicalRecordDocuments", fields: [medicalRecordId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([documentType])
  @@index([status])
  @@index([userId])
  @@index([companyId])
  @@index([patientId])
  @@index([professionalId])
  @@index([appointmentId])
  @@index([medicalRecordId])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================================
// Notificações (campanhas + recipients; category/actionUrl alinhados ao app)
// ============================================================================

/// Campanha ou aviso único. Destinatários efetivos em `NotificationRecipient`; segmentação opcional em `NotificationTarget`.
model Notification {
  id         String  @id @default(cuid())
  title      String
  message    String
  entityType String?
  entityId   String?

  category  AppNotificationCategory?
  actionUrl String?

  companyId       String?
  company         Company? @relation("CompanyNotifications", fields: [companyId], references: [id])
  createdByUserId String?

  recipients NotificationRecipient[] @relation("NotificationRecipients")
  targets    NotificationTarget[]    @relation("NotificationTargets")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([entityType])
  @@index([entityId])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Uma linha por utilizador destino: lido/não lido (inbox).
model NotificationRecipient {
  id     String    @id @default(cuid())
  isRead Boolean   @default(false)
  readAt DateTime?

  notificationId String
  notification   Notification @relation("NotificationRecipients", fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@index([isRead])
  @@index([readAt])
}

/// Agrupamento de utilizadores para disparo de notificações (por empresa).
model NotificationGroup {
  id           String                @id @default(cuid())
  name         String
  description  String?
  type         NotificationGroupType
  isActive     Boolean               @default(true)
  roleFilter   Roles?
  sectorFilter String?

  companyId     String
  company       Company                   @relation("CompanyNotificationGroups", fields: [companyId], references: [id])
  members       NotificationGroupMember[] @relation("GroupMembers")
  notifications NotificationTarget[]      @relation("GroupNotifications")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?

  @@index([companyId])
  @@index([type])
  @@index([isActive])
  @@index([roleFilter])
  @@index([deletedAt])
}

/// N:N entre `NotificationGroup` e `User`.
model NotificationGroupMember {
  id      String            @id @default(cuid())
  groupId String
  group   NotificationGroup @relation("GroupMembers", fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User              @relation("UserGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  addedBy   String?

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

/// Regra de segmentação de uma notificação (utilizador, papel, grupo, etc.).
model NotificationTarget {
  id      String                 @id @default(cuid())
  type    NotificationTargetType
  userId  String?
  roleId  Roles?
  groupId String?

  notificationId String
  notification   Notification       @relation("NotificationTargets", fields: [notificationId], references: [id], onDelete: Cascade)
  targetGroup    NotificationGroup? @relation("GroupNotifications", fields: [groupId], references: [id])

  createdAt DateTime @default(now())

  @@index([notificationId])
  @@index([type])
  @@index([userId])
  @@index([roleId])
  @@index([groupId])
}

/// Endpoint Web Push por dispositivo/navegador.
model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String
  auth     String
  userId   String
  user     User   @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([endpoint])
}
