// ═══════════════════════════════════════════════════════════════════════════════
// Patient - Perfil de Paciente do Usuário
// ═══════════════════════════════════════════════════════════════════════════════
//
// Relacionamento 1:1 com User.
// Armazena dados específicos de paciente (não de autenticação).

enum PatientCareStatus {
  ACTIVE
  INACTIVE
  NEEDS_ATTENTION
}

model Patient {
  id         String            @id @default(cuid())

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS OBRIGATÓRIOS
  // ═══════════════════════════════════════════════════════════════════════════
  // User é a identidade (email, password, etc)
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company é a clínica onde é paciente
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════════════════════
  // DADOS CLÍNICOS BÁSICOS
  // ═══════════════════════════════════════════════════════════════════════════
  healthPlan       String?
  careStatus       PatientCareStatus @default(ACTIVE)

  // Dados de saúde (prontuário resumido)
  bloodType          String?
  allergies          Json?  // string[]
  chronicConditions  Json?  // string[]

  // ═══════════════════════════════════════════════════════════════════════════
  // RESPONSÁVEL (para menores ou pacientes que precisam de acompanhante)
  // ═══════════════════════════════════════════════════════════════════════════
  guardianName       String?
  guardianPhone      String?
  guardianDocument   String?

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS
  // ═══════════════════════════════════════════════════════════════════════════
  appointments       Appointment[]

  // ═══════════════════════════════════════════════════════════════════════════
  // AUDITORIA
  // ═══════════════════════════════════════════════════════════════════════════
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // ═══════════════════════════════════════════════════════════════════════════
  // ÍNDICES
  // ═══════════════════════════════════════════════════════════════════════════
  @@index([companyId])
  @@index([careStatus])
  @@index([deletedAt])

  @@map("patients")
}