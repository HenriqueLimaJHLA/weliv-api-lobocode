// ═══════════════════════════════════════════════════════════════════════════════
// Professional - Perfil Profissional do Usuário
// ═══════════════════════════════════════════════════════════════════════════════
//
// Relacionamento 1:1 com User.
// Um User pode ser um profissional em uma ou mais clínicas.
// Para multi-clínica, considerar criar ProfessionalCompany como entidade associativa.
//
// Configurações (price, insurances, etc):
// - Se definido aqui, usa o valor do profissional
// - Se null, usa os defaults da Company

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  VACATION
}

model Professional {
  id                 String             @id @default(cuid())

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS OBRIGATÓRIOS
  // ═══════════════════════════════════════════════════════════════════════════
  // User é a identidade (email, password, etc)
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company é a clínica onde trabalha
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════════════════════
  // PERFIL PROFISSIONAL
  // ═══════════════════════════════════════════════════════════════════════════
  professionalTitle  String?           // "Dr.", "Dra.", "Prof.", etc.
  biography          String?            @db.Text
  registrationNumber String?             // CRM, CRO, CRP, etc (número de registro profissional)

  // Especialidade (N:1 - um profissional, uma especialidade)
  specialtyId        String?
  specialty          Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  // ═══════════════════════════════════════════════════════════════════════════
  // CONFIGURAÇÕES DE ATENDIMENTO
  // Se null, usa os defaults da Company
  // ═══════════════════════════════════════════════════════════════════════════
  consultationPrice   Decimal?           @db.Decimal(10, 2)
  acceptsInsurance   Boolean            @default(false)
  insurances         Json?              // string[] - convênios aceitos

  // ═══════════════════════════════════════════════════════════════════════════
  // CONFIGURAÇÕES DE AGENDA
  // Se null, usa appointmentSettings da Company
  // ═══════════════════════════════════════════════════════════════════════════
  remarcationEnabled  Boolean?
  remarcationLimit    Int?
  waitingListEnabled  Boolean?
  depositPercentage   Int?
  availableSchedule   Json?              // Grade de horários individual

  // ═══════════════════════════════════════════════════════════════════════════
  // STATUS E VISUAL
  // ═══════════════════════════════════════════════════════════════════════════
  status             ProfessionalStatus @default(ACTIVE)
  color              String?            // Cor de identificação no calendário

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS
  // ═══════════════════════════════════════════════════════════════════════════
  blockedTimes       ProfessionalBlockedTime[]
  appointments       Appointment[]         @relation("ProfessionalAppointments")
  scheduleReminders  ScheduleReminder[]

  // ═══════════════════════════════════════════════════════════════════════════
  // AUDITORIA
  // ═══════════════════════════════════════════════════════════════════════════
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  // ═══════════════════════════════════════════════════════════════════════════
  // ÍNDICES
  // ═══════════════════════════════════════════════════════════════════════════
  @@index([companyId])
  @@index([specialtyId])
  @@index([status])
  @@index([deletedAt])

  @@map("professionals")
}