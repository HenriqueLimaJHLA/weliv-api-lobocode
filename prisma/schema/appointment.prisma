// ═══════════════════════════════════════════════════════════════════════════════
// ProfessionalBlockedTime - Bloqueios de Agenda
// ═══════════════════════════════════════════════════════════════════════════════
//
// Períodos em que o profissional não estará disponível para agendamentos.
// Ex: férias, licença médica, reuniões, etc.

model ProfessionalBlockedTime {
  id         String   @id @default(cuid())

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTO
  // ═══════════════════════════════════════════════════════════════════════════
  professionalId String
  professional  Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════════════════════
  // DADOS DO BLOQUEIO
  // ═══════════════════════════════════════════════════════════════════════════
  blockedDate DateTime @db.Date
  startTime   String   // HH:MM
  endTime     String   // HH:MM
  reason      String

  // ═══════════════════════════════════════════════════════════════════════════
  // AUDITORIA
  // ═══════════════════════════════════════════════════════════════════════════
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ═══════════════════════════════════════════════════════════════════════════
  // ÍNDICES
  // ═══════════════════════════════════════════════════════════════════════════
  @@index([professionalId])
  @@index([blockedDate])
  @@index([professionalId, blockedDate])

  @@map("professional_blocked_times")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ScheduleReminder - Lembretes da Agenda
// ═══════════════════════════════════════════════════════════════════════════════
//
// Lembretes criados pelo profissional para a sua agenda.
// Ex: "Ligar para paciente X", "Preparar material Y"

model ScheduleReminder {
  id         String   @id @default(cuid())

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTO
  // ═══════════════════════════════════════════════════════════════════════════
  professionalId String
  professional  Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════════════════════
  // DADOS DO LEMBRETE
  // ═══════════════════════════════════════════════════════════════════════════
  title     String
  remindAt  DateTime
  note      String?

  // ═══════════════════════════════════════════════════════════════════════════
  // AUDITORIA
  // ═══════════════════════════════════════════════════════════════════════════
  createdAt DateTime @default(now())

  // ═══════════════════════════════════════════════════════════════════════════
  // ÍNDICES
  // ═══════════════════════════════════════════════════════════════════════════
  @@index([professionalId])
  @@index([remindAt])

  @@map("schedule_reminders")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Appointment - Agendamento
// ═══════════════════════════════════════════════════════════════════════════════
//
// Consulta/agendamento entre um paciente e um profissional.

enum AppointmentType {
  PRESENCIAL
  TELEMEDICINA
  WHATSAPP
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id String @id @default(cuid())

  // ═══════════════════════════════════════════════════════════════════════════
  // IDENTIFICAÇÃO
  // ═══════════════════════════════════════════════════════════════════════════
  // Identificador externo (para integração com outros sistemas)
  externalId  String?

  // ═══════════════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS
  // ═══════════════════════════════════════════════════════════════════════════
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])

  // Profissional responsável
  professionalId String
  professional   Professional @relation("ProfessionalAppointments", fields: [professionalId], references: [id])

  // Paciente
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id])

  // Serviço realizado (opcional)
  serviceId   String?
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // ═══════════════════════════════════════════════════════════════════════════
  // DADOS DO AGENDAMENTO
  // ═══════════════════════════════════════════════════════════════════════════
  startsAt     DateTime
  endsAt       DateTime?
  type         AppointmentType @default(PRESENCIAL)
  status       AppointmentStatus @default(SCHEDULED)

  // Informações de pagamento
  depositPaid    Boolean  @default(false)
  depositAmount   Decimal? @db.Decimal(10, 2)

  // Observações
  notes     String? @db.Text
  reason    String? // Motivo da consulta

  // ═══════════════════════════════════════════════════════════════════════════
  // AUDITORIA
  // ═══════════════════════════════════════════════════════════════════════════
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // ═══════════════════════════════════════════════════════════════════════════
  // ÍNDICES
  // ═══════════════════════════════════════════════════════════════════════════
  @@index([companyId])
  @@index([professionalId])
  @@index([patientId])
  @@index([startsAt])
  @@index([status])
  @@index([deletedAt])
  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])

  @@map("appointments")
}