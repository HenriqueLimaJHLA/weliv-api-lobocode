// ============================================================================
// Financeiro admin — cobranças (`ChargeRow`)
// ============================================================================

/// Conta a receber / cobrança exibida no módulo financeiro do admin.
model Charge {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyUnitId String?
  companyUnit   CompanyUnit? @relation(fields: [companyUnitId], references: [id], onDelete: SetNull)

  patientId String
  patient   User   @relation("ChargePatient", fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Referência humana tipo `APT-1040` (`appointmentRef` no mock).
  externalReference String?

  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime     @db.Date
  method         ChargeMethod
  status         ChargeStatus @default(PENDING)
  /// Ultimo lembrete enviado (lastReminderAt no mock).
  lastReminderAt DateTime?
  paidAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyUnitId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([dueDate])
  @@index([status])
}
