# Copie para .env e preencha (único arquivo com valores por projeto).
# docker/ e scripts/ não devem conter literais de projeto — só referências a estas chaves.

# --- App (Nest) ---
PORT=
APP_PORT=
NODE_ENV=development

# --- Banco (URL local; na VPS o compose injeta DATABASE_URL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO (app) ---
MINIO_HOST=
MINIO_PORT=9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_USE_SSL=false
MINIO_ENDPOINT=
MINIO_BUCKET_NAME=
MINIO_CONSOLE_PORT=9001

# --- Stack database (docker-compose.database.yml + scripts/start-database.sh) ---
COMPOSE_DATABASE_PROJECT_NAME=
DOCKER_NETWORK_NAME=
DB_CONTAINER_NAME=
REDIS_CONTAINER_NAME=
MINIO_CONTAINER_NAME=
POSTGRES_VOLUME_NAME=
REDIS_VOLUME_NAME=
MINIO_VOLUME_NAME=
DB_HOST_PORT=
REDIS_HOST_PORT=
MINIO_API_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=

# --- Backend na VPS (docker-compose.vps-app.yml) ---
COMPOSE_VPS_STACK_NAME=
BACKEND_CONTAINER_NAME=
VPS_APP_PROJECT_NAME=
APP_HOST=
# Entre aspas se houver espaços (scripts fazem source do .env).
APP_DISPLAY_NAME=
VPS_APP_COMPOSE_FILE=docker/docker-compose.vps-app.yml
VPS_DEFAULT_SERVICE=backend
APP_HOST_EXAMPLE=

# Labels Traefik no app — devem coincidir com traefik/.env.gateway na VPS
TRAEFIK_NETWORK=
TRAEFIK_CERT_RESOLVER=letsencrypt

# Gateway Traefik (uma vez por VPS): copie traefik/.env.gateway.example → traefik/.env.gateway
# File provider (opcional): traefik/.env.traefik-file-provider.example

# --- E-mail / URLs (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
AUTH_RESET_PASSWORD_URL=
FRONTEND_URL=
GEOCODING_USER_AGENT=

# --- Observabilidade (opcional) ---
ENABLE_PROMETHEUS_METRICS=false
ENABLE_AUDIT_LOGS=false
PROMETHEUS_METRICS_PREFIX=
METRICS_EXPORT_INTERVAL=15s
PROMETHEUS_BASE_URL=
GRAFANA_BASE_URL=

# --- Integrações (opcional) ---
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_CUSTOMER_ID=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
  