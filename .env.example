# Copie para .env e preencha (único arquivo com valores por projeto).
# docker/.env deve espelhar as chaves usadas em docker-compose.*.yml.

# --- App (Nest) ---
PORT=30100
APP_PORT=30100
NODE_ENV=development

# --- Banco ---
DB_NAME=weliv-engine
DB_USER=postgres
DB_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:15432/weliv-engine?schema=public

# --- JWT ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO (app) ---
MINIO_HOST=localhost
MINIO_PORT=19000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me
MINIO_USE_SSL=false
MINIO_ENDPOINT=http://localhost:19000
MINIO_BUCKET_NAME=weliv-files
MINIO_CONSOLE_PORT=9001

# --- Stack database ---
COMPOSE_DATABASE_PROJECT_NAME=weliv-database
DOCKER_NETWORK_NAME=app-net-weliv
DB_CONTAINER_NAME=weliv-db
REDIS_CONTAINER_NAME=weliv-redis
MINIO_CONTAINER_NAME=weliv-minio
POSTGRES_VOLUME_NAME=weliv-postgres-data
REDIS_VOLUME_NAME=weliv-redis-data
MINIO_VOLUME_NAME=weliv-minio-data
DB_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# --- Backend na VPS ---
COMPOSE_VPS_STACK_NAME=weliv-vps
BACKEND_CONTAINER_NAME=weliv-backend
VPS_APP_PROJECT_NAME=weliv
APP_HOST=api.weliv.com.br
APP_DISPLAY_NAME=Weliv API
VPS_APP_COMPOSE_FILE=docker/docker-compose.vps-app.yml
VPS_DEFAULT_SERVICE=backend
APP_HOST_EXAMPLE=api.weliv.com.br
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_CERT_RESOLVER=letsencrypt
REDIS_URL=redis://weliv-redis:6379

# --- E-mail / URLs (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
AUTH_RESET_PASSWORD_URL=
FRONTEND_URL=http://localhost:42100
GEOCODING_USER_AGENT=weliv-api/1.0

# --- Observabilidade (opcional) ---
ENABLE_PROMETHEUS_METRICS=false
ENABLE_AUDIT_LOGS=false
PROMETHEUS_METRICS_PREFIX=weliv_
METRICS_EXPORT_INTERVAL=15s
PROMETHEUS_BASE_URL=
GRAFANA_BASE_URL=

# --- Integrações (opcional) ---
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_CUSTOMER_ID=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@weliv.com
