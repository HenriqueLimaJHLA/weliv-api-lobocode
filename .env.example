# =============================================================================
# LOBO CODE AI SOFTWARE FACTORY - Template de variáveis de ambiente
# Copie para .env e configure conforme seu ambiente.
# =============================================================================

# --- App (Nest) ---
PORT=3000
APP_PORT=3000
NODE_ENV=development

# --- Banco de dados ---
DB_NAME=lobocode_dev
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lobocode_dev?schema=public"

# --- JWT ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO (Storage) ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_USE_SSL=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=lobocode-files
MINIO_CONSOLE_PORT=9001

# --- Docker Stack (docker-compose.database.yml + scripts/start-database.sh) ---
COMPOSE_DATABASE_PROJECT_NAME=lobocode-dev-database
DOCKER_NETWORK_NAME=app-net-lobocode-dev
DB_CONTAINER_NAME=lobocode-dev-db
REDIS_CONTAINER_NAME=lobocode-dev-redis
MINIO_CONTAINER_NAME=lobocode-dev-minio
POSTGRES_VOLUME_NAME=lobocode_dev_postgres_data
REDIS_VOLUME_NAME=lobocode_dev_redis_data
MINIO_VOLUME_NAME=lobocode_dev_minio_data
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- VPS (docker-compose.vps-app.yml) ---
COMPOSE_VPS_STACK_NAME=lobocode-vps
BACKEND_CONTAINER_NAME=lobocode-backend
VPS_APP_PROJECT_NAME=lobocode
APP_HOST=api.lobocode.localtest.me
APP_DISPLAY_NAME="LoboCode API"
VPS_APP_COMPOSE_FILE=docker/docker-compose.vps-app.yml
VPS_DEFAULT_SERVICE=backend
APP_HOST_EXAMPLE=api.seu-dominio.com

# --- Traefik ---
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- E-mail / URLs ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev@example.com
SMTP_PASS=dev_password
SMTP_FROM="LoboCode Dev <dev@example.com>"
SUPPORT_EMAIL=support@localhost
AUTH_RESET_PASSWORD_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
GEOCODING_USER_AGENT=lobocode-dev/1.0

# --- Observabilidade ---
ENABLE_PROMETHEUS_METRICS=false
ENABLE_AUDIT_LOGS=false
PROMETHEUS_METRICS_PREFIX=lobocode_
METRICS_EXPORT_INTERVAL=15s
PROMETHEUS_BASE_URL=http://localhost:9090
GRAFANA_BASE_URL=http://localhost:3000

# --- Integrações (opcional) ---
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_CUSTOMER_ID=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_URL=http://localhost:3000/asaas/webhooks/payments
ASAAS_WEBHOOK_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
